# Copy this file to .env and update with your own values

# ============================================
# Required Settings
# ============================================

# Public base url
BASE_URL=https://dev.bs-assistant.door43.org

# Your OpenAI API key
OPENAI_API_KEY=sk-r4nd0mFAK3k3yXxXxXxXxXxXxXxXxXxXxXxXxXx

# Secret used to derive log-safe user identifiers
LOG_PSEUDONYM_SECRET=generate-and-set-unique-secret

# ============================================
# Application Settings
# ============================================

# Data directory for ChromaDB and conversation storage
DATA_DIR=/data

# ============================================
# Logging
# ============================================

# log level (debug | info | warning | error)
BS_ASSISTANT_LOG_LEVEL=info

# optional directory for application logs (defaults to ./logs then DATA_DIR/logs)
BS_ASSISTANT_LOG_DIR=./logs

# ============================================
# LLM Configuration
# ============================================

# Default model for complex queries
DEFAULT_MODEL=gpt-4o

# Model for simple queries (cheaper)
SIMPLE_QUERY_MODEL=gpt-4o-mini

# Temperature for LLM responses (0.0-1.0)
TEMPERATURE=0.7

# Maximum tokens to generate
MAX_TOKENS=2000

# ============================================
# RAG Configuration
# ============================================

# Path to ChromaDB vector store
VECTOR_STORE_PATH=data/chroma

# Embedding model name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Maximum number of retrieval results
MAX_RETRIEVAL_RESULTS=10

# Similarity threshold for vector search (0.0-1.0)
SIMILARITY_THRESHOLD=0.7

# ============================================
# Verse Limits
# ============================================

# Maximum verses to retrieve for scripture requests
RETRIEVE_SCRIPTURE_VERSE_LIMIT=120

# Maximum verses for translation requests
TRANSLATE_SCRIPTURE_VERSE_LIMIT=120

# Maximum verses for translation helps
TRANSLATION_HELPS_VERSE_LIMIT=5

# ============================================
# Conversation Settings
# ============================================

# Storage type for conversations (memory | tinydb)
CONVERSATION_STORE=memory

# Maximum messages to keep in history
CONVERSATION_HISTORY_MAX_MESSAGES=10

# Path for conversation storage (if using tinydb)
CONVERSATION_HISTORY_PATH=data/conversations.json

# ============================================
# Response Configuration
# ============================================

# Maximum response text length
MAX_RESPONSE_TEXT_LENGTH=50000

# ============================================
# Admin & Security
# ============================================

# Enable admin authentication
ENABLE_ADMIN_AUTH=False

# Admin API token
ADMIN_API_TOKEN=change-me-for-admin

# Health check API token
HEALTHCHECK_API_TOKEN=change-me-for-health

# ============================================
# Cost Tracking
# ============================================

# Enable cost tracking for LLM calls
COST_TRACKING_ENABLED=True

# OpenAI pricing (JSON format)
OPENAI_PRICING_JSON={"gpt-4o": {"input_per_million": 2.5, "output_per_million": 10.0}, "gpt-4o-mini": {"input_per_million": 0.15, "output_per_million": 0.6}}
